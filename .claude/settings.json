{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "permissions": {
    "deny": [
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./**/secrets/**)",
      "Grep(./backend/.env)",
      "Grep(./frontend/.env)",
      "Grep(./**/secrets/**)",
      "Glob(./**/secrets/**)"
    ]
  }
}
