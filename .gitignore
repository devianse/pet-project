# --- Go (backend/) ---
/backend/bin/
# `go build ./...` from backend/ drops the binary at the module root, named
# after cmd/api — not into bin/. Ignore it directly rather than relying on
# always remembering `-o bin/api`.
/backend/api
*.exe
*.test
*.out

# --- Node / React (frontend/) ---
/frontend/node_modules/
/frontend/dist/
/frontend/build/
/frontend/.vite/
*.tsbuildinfo
.eslintcache

# --- Env / secrets (anywhere) ---
.env
.env.*
!.env.example

# --- Claude Code ---
/.claude/worktrees/
/.claude/settings.local.json
/.superpowers/

# --- Local-only design docs (not shared to remote) ---
/docs/superpowers/

# --- Personal reference (not project docs) ---
CHEATSHEET.local.md
infra/DEPLOYMENT_RUNBOOK.local.md

# --- Editor / OS cruft ---
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
