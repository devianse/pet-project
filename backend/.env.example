PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes?sslmode=disable
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# Signs/verifies session JWTs — generate a real random value for anything
# beyond local dev, e.g.: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me

# "production" makes the session cookie Secure (HTTPS-only); anything
# else (including unset) keeps it off so local dev over plain http works.
ENV=development
