# Domain Caddy requests a TLS cert for. Use "localhost" for local testing
# (Caddy falls back to its internal CA — curl needs -k against it); use
# your real domain once deploying to the VPS.
# Caution: the Caddyfile sends Strict-Transport-Security for this domain.
# Browsers key HSTS by hostname, not port — visiting https://localhost
# once pins ALL http://localhost:* projects on this machine to HTTPS for
# a year (clear it via chrome://net-internals/#hsts if that bites you).
DOMAIN=localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notes

# TMDb v4 read access token — backend exits on startup if this is unset.
# Same value as backend/.env's TMDB_READ_ACCESS_TOKEN.
TMDB_READ_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# Signs/verifies session JWTs — generate a real random value, e.g.:
# openssl rand -base64 32
# Same value as backend/.env's JWT_SECRET.
JWT_SECRET=

# The exactly-two usernames Date Night is scoped to, comma-separated —
# backend exits on startup if this is unset. Must exactly match the
# seeded account usernames, case-sensitive: matching is exact, not
# case-folded, so a mis-cased value here reads as a 403, not a login
# failure (see backend/internal/datenight/pair.go's LoadPair doc comment).
# Same value as backend/.env's DATE_NIGHT_USERNAMES.
DATE_NIGHT_USERNAMES=
